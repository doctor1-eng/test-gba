  "bugs": {
    "url": "https://github.com/doctor1-eng/test-gba/issues"
  },
  "homepage": "https://github.com/doctor1-eng/test-gba#readme",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  }
}

// =====================================================================
// TEMPLATE GÉNÉRIQUE — Quêtes annexes par ville/route (compact)
// Fork pokeemerald-expansion — Heart & Soul
// =====================================================================
// Le texte narratif complet de chaque quête est dans docs/histoire.md
// section 8. Ici : uniquement le squelette fonctionnel (flag + éventuel
// gain de réputation selon le barème de la section 9). À enrichir de
// dialogues complets au moment de l'intégration réelle.
// =====================================================================

// --- Route 1 : objet perdu de la famille de réfugiés ---
script EventScript_Route1_ObjetPerdu {
    lock
    faceplayer
    if (flag(FLAG_ROUTE1_OBJET_RENDU) == TRUE) {
        msgbox("\"Merci encore pour votre aide.\"", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("\"Vous avez retrouvé notre bien ? Merci infiniment.\"", MSGBOX_DEFAULT)
    setflag(FLAG_ROUTE1_OBJET_RENDU)
    addvar(VAR_REPUTATION, 1)
    release
    end
}

// --- Viridian City : commerçant résistant ---
script EventScript_Viridian_CommercantResistant {
    lock
    faceplayer
    if (flag(FLAG_VIRIDIAN_COMMERCANT_AIDE) == TRUE) {
        msgbox("\"Reste prudent, dehors.\"", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("\"Aide-moi à faire passer ces informations, discrètement.\"", MSGBOX_DEFAULT)
    setflag(FLAG_VIRIDIAN_COMMERCANT_AIDE)
    addvar(VAR_REPUTATION, 1)
    release
    end
}

// --- Viridian Forest : bûcherons déplacés ---
script EventScript_ViridianForest_Bucherons {
    lock
    faceplayer
    if (flag(FLAG_FORET_BUCHERONS_AIDES) == TRUE) {
        msgbox("\"On s'en sort, grâce à toi.\"", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("\"On n'a plus de travail depuis que la Team Rocket a\n'repris' la forêt. Tu peux nous aider ?\"", MSGBOX_DEFAULT)
    setflag(FLAG_FORET_BUCHERONS_AIDES)
    addvar(VAR_REPUTATION, 1)
    release
    end
}

// --- Mont Sélénite : chercheuse rationaliste ---
script EventScript_MontSelenite_Chercheuse {
    lock
    faceplayer
    if (flag(FLAG_CHERCHEUSE_SOUTENUE) == TRUE) {
        msgbox("\"La science finira par avoir raison du folklore.\"", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("\"Selen raconte n'importe quoi sur les météorites. Aide-moi\nà prouver mes recherches ?\"", MSGBOX_DEFAULT)
    setflag(FLAG_CHERCHEUSE_SOUTENUE)
    addvar(VAR_REPUTATION, 1)
    release
    end
}


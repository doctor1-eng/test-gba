// --- Vermilion City : interception radio (Major Bob) ---
script EventScript_Vermilion_InterceptionRadio {
    lock
    faceplayer
    if (flag(FLAG_INTERCEPTION_RADIO_REUSSIE) == TRUE) {
        msgbox("\"Toujours rien de nouveau sur les fréquences.\"", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("Major Bob : \"Aide-moi à décoder cette transmission Rocket.\"", MSGBOX_DEFAULT)
    // Ici : insérer un mini-jeu ou une séquence de choix si le fork le permet.
    setflag(FLAG_INTERCEPTION_RADIO_REUSSIE)
    addvar(VAR_REPUTATION, 1)
    release
    end
}

// --- Zone Safari : libération des Pokémon braconnés ---
script EventScript_Safari_LibererPokemon {
    lock
    faceplayer
    if (flag(FLAG_POKEMON_BRACONNES_LIBERES) == TRUE) {
        msgbox("Les cages sont vides, désormais.", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("Des Pokémon capturés illégalement s'agitent dans leurs cages.", MSGBOX_DEFAULT)
    setflag(FLAG_POKEMON_BRACONNES_LIBERES)
    addvar(VAR_REPUTATION, 1)
    release
    end
}

// --- Fuchsia City : débat du clan de Koga ---
script EventScript_Fuchsia_DebatKoga {
    lock
    faceplayer
    if (flag(FLAG_DEBAT_KOGA_RESOLU) == TRUE) {
        msgbox("Le clan a choisi sa voie.", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("\"Engagement direct ou stratégie de l'ombre : à toi de trancher.\"", MSGBOX_DEFAULT)
    multichoice(0, 0, MULTI_FUCHSIA_KOGA, FALSE)
    switch (var(VAR_RESULT)) {
        case 0: setflag(FLAG_KOGA_ENGAGEMENT_DIRECT); goto EventScript_Fuchsia_DebatKoga_Fin
        case 1: setflag(FLAG_KOGA_STRATEGIE_OMBRE); goto EventScript_Fuchsia_DebatKoga_Fin
        case MULTI_B_PRESSED: goto EventScript_Fuchsia_DebatKoga
    }
    end
}

script EventScript_Fuchsia_DebatKoga_Fin {
    setflag(FLAG_DEBAT_KOGA_RESOLU)
    addvar(VAR_REPUTATION, 1)
    release
    end
}

// --- Céladopole : financement Rocket du grand magasin ---
script EventScript_Celadopole_FinancementRocket {
    lock
    faceplayer
    if (flag(FLAG_FINANCEMENT_ROCKET_EXPOSE) == TRUE) {
        msgbox("Le scandale a déjà éclaté.", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("Les registres du sous-sol du grand magasin ne mentent pas.", MSGBOX_DEFAULT)
    setflag(FLAG_FINANCEMENT_ROCKET_EXPOSE)
    addvar(VAR_REPUTATION, 2)
    release
    end
}

// --- Saffron / Silph Co : documents sur Mira Voss ---
script EventScript_Saffron_DocumentsMiraVoss {
    lock
    faceplayer
    if (flag(FLAG_DOCUMENTS_MIRA_VOSS_LUS) == TRUE) {
        msgbox("Vous avez déjà lu ce dossier.", MSGBOX_DEFAULT)
        release
        end
    }
    msgbox("Un dossier RH mentionne l'éviction de Mira Voss au profit\nd'un cadre mieux connecté.", MSGBOX_DEFAULT)
    setflag(FLAG_DOCUMENTS_MIRA_VOSS_LUS)
    addvar(VAR_REPUTATION, 1)
    release
    end
}

// NOTES GÉNÉRALES :
// - Pallet Town (jeune dresseur), Pewter City (Pierre/vivres) et
//   Cinnabar (réfugiés du Mont Cinnabar) ont des scripts dédiés plus
//   développés ailleurs (cinnabar_acte1.pory pour Cinnabar). Pewter et
//   Pallet sont volontairement de simples scènes de dialogue sans choix
//   ni impact réputation direct (voir docs/histoire.md section 8) — pas
//   de script séparé nécessaire, une simple série de msgbox suffit.
// - MULTI_FUCHSIA_KOGA à définir avec les 2 libellés exacts.
// - Tous les FLAG_* de ce fichier sont à déclarer dans
//   include/constants/flags.h.
